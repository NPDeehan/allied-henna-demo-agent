    <bpmn:scriptTask id="Activity_0d4dz0n" name="Create Input">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  &#34;messageFromEmail&#34; : currentEmail.plainTextBody&#10;}" resultVariable="questionFromUser" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n8ctrm</bpmn:incoming>
      <bpmn:outgoing>Flow_1nysfn1</bpmn:outgoing>
