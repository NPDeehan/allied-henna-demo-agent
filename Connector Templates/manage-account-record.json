      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "balance"
      },
      "constraints": {
        "notEmpty": true,
        "pattern": "^([+-]?[0-9]+(\\.[0-9]+)?|=.+)$"
      },
      "condition": {
        "property": "operation",
        "equals": "CREATE",
        "type": "simple"
      }
