{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Manage Account Record",
  "id": "com.example.camunda.manage-account-record",
  "version": 6,
  "description": "Create, update, or delete account records with operation-aware form fields. Account ID is auto-generated on CREATE when omitted. Account type accepts SAVINGS, CORPORATE, or PERSONAL (or a FEEL runtime expression that resolves to one of these).",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:ServiceTask"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "input",
      "label": "Input Parameters"
    },
    {
      "id": "output",
      "label": "Output Mapping"
    },
    {
      "id": "errors",
      "label": "Error Handling"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "manage-account-record",
      "binding": {
        "type": "zeebe:taskDefinition:type"
      }
    },
    {
      "id": "operation",
      "label": "Operation",
      "description": "Select which account action to run.",
      "type": "Dropdown",
      "value": "CREATE",
      "choices": [
        {
          "name": "CREATE",
          "value": "CREATE"
        },
        {
          "name": "UPDATE",
          "value": "UPDATE"
        },
        {
          "name": "DELETE",
          "value": "DELETE"
        }
      ],
      "group": "input",
      "binding": {
        "type": "zeebe:input",
        "name": "operation"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "accountIdCreate",
      "label": "Account ID",
      "description": "Optional for CREATE. If omitted, the service auto-generates the next account ID.",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountId"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operation",
        "equals": "CREATE",
        "type": "simple"
      }
    },
    {
      "id": "accountIdUpdate",
      "label": "Account ID",
      "description": "Required for UPDATE.",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountId"
      },
      "constraints": {
        "notEmpty": true,
        "pattern": "^([1-9][0-9]*|=.+)$"
      },
      "condition": {
        "property": "operation",
        "equals": "UPDATE",
        "type": "simple"
      }
    },
    {
      "id": "accountIdDelete",
      "label": "Account ID",
      "description": "Required for DELETE.",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountId"
      },
      "constraints": {
        "notEmpty": true,
        "pattern": "^([1-9][0-9]*|=.+)$"
      },
      "condition": {
        "property": "operation",
        "equals": "DELETE",
        "type": "simple"
      }
    },
    {
      "id": "accountNumberCreate",
      "label": "Account Number",
      "description": "Required for CREATE.",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountNumber"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operation",
        "equals": "CREATE",
        "type": "simple"
      }
    },
    {
      "id": "accountNumberUpdate",
      "label": "Account Number",
      "description": "Optional for UPDATE.",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountNumber"
      },
      "condition": {
        "property": "operation",
        "equals": "UPDATE",
        "type": "simple"
      }
    },
    {
      "id": "accountTypeCreate",
      "label": "Account Type",
      "description": "Required for CREATE. Use SAVINGS, CORPORATE, or PERSONAL. Runtime mapping is supported with FEEL (for example: =accountTypeVar).",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountType"
      },
      "constraints": {
        "notEmpty": true,
        "pattern": "^(SAVINGS|CORPORATE|PERSONAL|=.+)$"
      },
      "condition": {
        "property": "operation",
        "equals": "CREATE",
        "type": "simple"
      }
    },
    {
      "id": "accountTypeUpdate",
      "label": "Account Type",
      "description": "Optional for UPDATE. Use SAVINGS, CORPORATE, or PERSONAL. Runtime mapping is supported with FEEL (for example: =accountTypeVar).",
      "type": "Text",
      "group": "input",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
